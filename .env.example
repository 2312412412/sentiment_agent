# Copy this file to .env and fill in your own values.

# LLM provider: openai or dashscope.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=replace-with-your-llm-api-key

# Optional. Leave empty for the provider default endpoint.
# DashScope compatible endpoint example:
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=

# Optional. Required only when you want Tavily-powered web/news search.
TAVILY_API_KEY=

# Gradio runtime options.
GRADIO_PORT=7860
GRADIO_SHARE=false

# Analysis and storage options.
SENTIMENT_THRESHOLD=0.6
MEMORY_PATH=./memory_data
VECTOR_STORE_PATH=./vector_store
